opam-version: "2.0"
version: "0.1.0"
synopsis: "Zeroized secret memory outside the OCaml heap"
description: """
Secret.t stores fixed-length data outside the OCaml heap. It supports explicit
zeroization, constant-time equality, optional page hardening, and zero-copy views."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "ISC"
tags: ["security" "cryptography" "memory"]
homepage: "https://github.com/thevilledev/ocaml-secret"
bug-reports: "https://github.com/thevilledev/ocaml-secret/issues"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.14.0" & < "5.6"}
  "dune-configurator"
  "alcotest" {with-test & >= "1.7.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-secret.git"
