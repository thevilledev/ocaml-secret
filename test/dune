(test
 (name test_atexit)
 (modules test_atexit)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (>= %{ocaml_version} 5.0)))
 (deps %{exe:atexit_child.exe})
 (action
  (setenv
   SECRET_CHILD_EXE
   %{exe:atexit_child.exe}
   (run %{test})))
 (libraries secret helpers alcotest unix))

