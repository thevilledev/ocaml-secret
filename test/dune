(executable
 (name test_mlock_limit)
 (modules test_mlock_limit)
 (libraries secret))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (deps %{exe:test_mlock_limit.exe})
 (action
  ; dune before 3.24 expands %{exe:...} to a bare basename, which sh then
  ; looks up through PATH and fails to find; name the path explicitly.
  (run sh -c "ulimit -l 0 && exec ./test_mlock_limit.exe")))

; Gated rather than selected: dune before 3.15 rejects a (select) target
; named in (modules), and this matches how test_unix_wipe is gated.

(test
 (name test_unix)
 (modules test_unix)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   %{lib-available:secret.unix}))
 (libraries secret secret.unix alcotest unix))

(test
 (name test_unix_wipe)
 (modules test_unix_wipe)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   %{lib-available:secret.unix}))
 (libraries secret secret.unix helpers alcotest unix))

(executable
 (name leak_scan)
 (modules leak_scan)
 (optional)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries secret mirage-crypto)
 (foreign_stubs
  (language c)
  (names leak_scan_stubs)
  (include_dirs %{project_root}/src)))

(executable
 (name mirage_crypto_consumer)
 (modules mirage_crypto_consumer)
 (optional)
 (libraries secret mirage-crypto))

(rule
 (alias mirage-crypto-proof)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (= %{env:SECRET_MIRAGE_CRYPTO=false} true)))
 (action
  (progn
   (run %{exe:mirage_crypto_consumer.exe})
   (run %{exe:leak_scan.exe}))))

(rule
 (alias census)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (= %{env:SECRET_CENSUS=false} true)))
 (action
  (run %{exe:leak_scan.exe})))
